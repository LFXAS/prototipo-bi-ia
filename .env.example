# Compose
COMPOSE_PROJECT_NAME=bi-ia-prototype
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Application
APP_NAME=Prototipo BI asistido por IA
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL interno/datamart exclusivo de este Compose
LOCAL_POSTGRES_PORT=55432
POSTGRES_DB=bi_prototype
POSTGRES_USER=bi_app
POSTGRES_PASSWORD=ChangeMe_Postgres_2026!

# SQL Server AdventureWorks exclusivo de este Compose
# Este usuario debe poseer exclusivamente permisos de lectura en AdventureWorks.
LOCAL_SQLSERVER_PORT=51433
SQLSERVER_DATABASE=AdventureWorks2022
SQLSERVER_USER=bi_reader
SQLSERVER_PASSWORD=ChangeMe_Reader_2026!
SQLSERVER_SA_PASSWORD=ChangeMe_SA_2026!
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
SQLSERVER_APPLICATION_INTENT=ReadOnly

# Frontend. Vacío usa el proxy de Vite/Nginx hacia el backend.
VITE_API_BASE_URL=
